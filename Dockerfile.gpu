# ─────────────────────────────────────────────────────────────────────────────
# Chorus Engine — GPU Dockerfile (CUDA-enabled)
# ─────────────────────────────────────────────────────────────────────────────
# Uses the official NVIDIA CUDA base image so that PyTorch (used by Whisper
# and pyannote.audio) can access the host GPU via the NVIDIA Container Toolkit.
#
# The base image supplies the CUDA userspace and the NVIDIA Container Toolkit
# contract. The CUDA runtime PyTorch actually uses comes from its own wheels,
# pulled in by requirements.txt, so the effective CUDA version is PyTorch's and
# not the base image tag's. At the pins in requirements.txt that is CUDA 13.0
# with cuDNN 9, which needs a correspondingly recent NVIDIA driver on the host.
# Verify with:
#   docker run --rm --gpus all <image> python3 -c \
#     "import torch; print(torch.__version__, torch.version.cuda)"
#
# Base image: nvidia/cuda 12.1.1, Ubuntu 22.04
#   https://hub.docker.com/r/nvidia/cuda/tags
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS builder-gpu

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv \
        python3-pip \
        build-essential \
        git \
        curl \
        libsndfile1-dev \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Symlink python3.11 as python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip wheel setuptools

# PyTorch is not installed separately here. An explicit torch==2.2.0+cu121 install
# used to precede this step, but requirements.txt pins pyannote-audio and torchcodec
# versions that require a far newer torch, so pip uninstalled the CUDA wheels again
# moments later ("Successfully uninstalled torch-2.2.0+cu121") after downloading
# roughly 2.5 GB for nothing. Letting requirements.txt govern gives the same result
# without the wasted download, and keeps the CPU and GPU images resolving from one
# source of truth. The resulting torch is still a CUDA build, which the smoke test
# in the header verifies.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS runtime-gpu

ARG VERSION=dev
LABEL maintainer="Chorus Engine"
LABEL description="Chorus — GPU-accelerated consensus transcription engine"
LABEL version="${VERSION}"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        ffmpeg \
        libsndfile1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

COPY --from=builder-gpu /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Create a non-root user for running the application
RUN useradd -m -r -s /bin/false chorus

COPY . /app/

RUN mkdir -p /app/outputs/variants \
             /app/outputs/transcripts \
             /app/outputs/consensus \
             /app/sample_audio \
             /home/chorus/.cache/whisper \
    && chown -R chorus:chorus /app /home/chorus

# GPU-specific defaults
ENV WHISPER_MODEL="small"
ENV WHISPER_DEVICE="cuda"

ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=127.0.0.1
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_SERVER_HEADLESS=true

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run as non-root user
USER chorus

CMD ["streamlit", "run", "ui/app.py", \
     "--server.port=8501", \
     "--server.address=127.0.0.1", \
     "--server.headless=true"]
