# ─────────────────────────────────────────────────────────────────────────────
# Chorus Engine — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values as required:
#   cp .env.example .env
#
# Docker Compose will automatically load .env from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# Whisper model size: tiny | base | small | medium | large
# "base" (~145 MB) is recommended for CPU-only environments.
# "small" (~461 MB) offers improved accuracy at the cost of speed.
# Tip — Apple Silicon native, 8 GB unified memory: use "small" or "medium".
#        "large" may exceed available memory on 8 GB configurations.
WHISPER_MODEL=base

# Compute device: cpu | cuda | mps
# Leave blank to auto-detect (recommended): CUDA → MPS → CPU.
#   cpu   Works everywhere. Default if no GPU is found.
#   cuda  NVIDIA GPU. Linux native or Windows via Docker Desktop + WSL2.
#   mps   Apple Silicon GPU. Native macOS only — not available inside Docker.
WHISPER_DEVICE=

# Language hint for Whisper (BCP-47 code, e.g. "en", "fr", "de").
# Leave blank for automatic language detection.
WHISPER_LANGUAGE=

# Word-level timestamps: 1 | true | yes to enable, blank to disable (default).
# Only needed for word-level SRT/VTT subtitle cues; subtitle export falls back
# to segment-level cues without them. Leave this off unless you need that
# granularity: Whisper's word-timestamp alignment can collapse long-form
# transcription into a repetition loop, which on a 28.8-minute recording cut
# the same model from 1,643 words to 137.
WORD_TIMESTAMPS=

# ── Storage ──────────────────────────────────────────────────────────────────
# Retain the intermediate cleaned WAVs in outputs/variants/ after a run:
# 1 | true | yes to keep, blank to delete them (default).
# The four variant WAVs per recording are Whisper inputs only and are dead
# weight once the transcripts exist — roughly 100 MB per recording, and they
# accumulate indefinitely. Enable only when debugging the cleaning filters.
KEEP_VARIANT_WAVS=

# ── LLM Reconstruction (optional) ────────────────────────────────────────────
# Uses a local Ollama model to resolve LOW-confidence tokens after consensus.
# Requires Ollama installed and running separately — see the Help page in the
# UI for step-by-step setup, or visit https://ollama.com.
# Leave all values unset (or the checkbox unticked in the UI) to disable.
#
# Recommended model: qwen2.5:3b (~2 GB download) — fast, and reliably follows
# the "respond with only the token" instruction this feature depends on.
# For technical/rare-vocabulary audio, qwen2.5:14b (~9 GB, 16 GB RAM
# recommended) retains more long-tail vocabulary at the cost of speed.
#
# Quick start:
#   brew install ollama
#   ollama serve
#   ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=20

# ── Speaker Diarisation (optional) ───────────────────────────────────────────
# Diarisation downloads the gated pyannote/speaker-diarization-3.1 model,
# which requires a free Hugging Face access token of type "Read" (Chorus only
# downloads model weights — never use a Write token):
#   1. Create the token: https://huggingface.co/settings/tokens/new
#   2. Accept the model terms: https://huggingface.co/pyannote/speaker-diarization-3.1
# The survey script (bash devops-practices/survey-ollama-env.sh) can validate
# the token and write it here for you. See docs/CONFIGURATION.md — Speaker
# Diarisation. Leave blank to run without diarisation (stub mode).
HUGGINGFACE_TOKEN=
